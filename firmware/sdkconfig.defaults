# ---- Target ----
# Flash size and PSRAM mode come from variants/<module>.defaults (see
# ESP_IDF_SDKCONFIG_DEFAULTS in Cargo.toml and the CI matrix). PSRAM is
# required: network thread stacks and TLS buffers live there.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# The heap prefers PSRAM for every size. With 8192 here (smaller allocations
# go to internal RAM first) the node's many small allocations filled the
# internal RAM: on a tailnet of 48 peers 13 KB of it was left three minutes
# after boot, which is little for what must be internal (Wi-Fi, the stacks
# of threads that write flash). With 0, 148 KB stays free (XIAO ESP32S3,
# 2026-11-13).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# ---- Tasks / stacks ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
# Task WDT: the supervisor thread subscribes itself and reboots the device
# when the node's locks stop being obtainable.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ---- Console: UART0 (the native USB port is the USB host or the setup console) ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---- Networking ----
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_IPV6=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# ---- TLS (control-plane /key fetch and DERP) ----
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=8192

# ---- USB: the native port is USB Serial/JTAG (setup console) or USB-OTG host (normal mode).
# Keep the IDF console off USB Serial/JTAG so the setup shell owns it.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# The host library refuses to enumerate a device whose configuration
# descriptor is longer than this (default 256). A UVC camera's runs to
# kilobytes (a SANWA document camera, 04fc:2680: 1434 bytes). The buffer is
# taken per attached device, and there is one.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096

# ---- Size ----
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ---- Speed (ESP32-S3; the C3 has neither option and ignores them) ----
# Every USB/IP transfer goes through WireGuard and the TCP stack twice, and
# most of that time was spent fetching code from flash: a 32 KB instruction
# cache took a round trip from 4.9 to 4.2 ms, 240 MHz from 5.3 to 4.9 ms
# (YD-ESP32-S3 N8R2). The cache costs 16 KB of internal RAM.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
