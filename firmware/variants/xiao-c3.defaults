# Seeed Studio XIAO ESP32C3: ESP32-C3 (RISC-V, one core), 4 MB flash, no PSRAM.
# Built with `--features board-xiao-c3 --target riscv32imc-esp-espidf` and MCU=esp32c3.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# ---- RAM: about 320 KB in all, shared with the code kept in RAM ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2560
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=10
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
# TLS record buffers allocated once per connection instead of for every
# record: the per-record 4.4 KB blocks of the DERP connection fragmented the
# heap until one could not be found (16 KB free, 4.3 KB largest block).
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
